{
    "compilerOptions": {
        "rootDir": "src",
        "outDir": "out",
        "module": "commonjs",
        "target": "ES2022",
        "lib": ["ES2022"],
        "sourceMap": true,
        "strict": true,
        "noImplicitOverride": true,
        "noUnusedLocals": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "types": ["node", "vscode"]
    },
    "include": ["src/**/*"]
}
